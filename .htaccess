<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 2. Block access to sensitive files
    RewriteRule ^\.env.*$ - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]
    RewriteRule ^package(-lock)?\.json$ - [F,L]
    RewriteRule ^artisan$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)(/|$) - [F,L]

    # 3. Force /vendor and /sale routes to be handled by Laravel's index.php instead of physical directories
    RewriteRule ^(vendor|sale)($|/.*) index.php [L,QSA]

    # 4. Serve physical static files directly (images, css, js, fonts)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 5. Serve uploads and storage from public folder
    RewriteCond %{DOCUMENT_ROOT}/public/uploads/$1 -f
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

    RewriteCond %{DOCUMENT_ROOT}/public/storage/$1 -f
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # 6. Route Next.js static assets directly from frontend/.next/static
    RewriteRule ^_next/static/(.*)$ frontend/.next/static/$1 [L]

    # 7. Route Next.js public files if they exist in frontend/public
    RewriteCond %{DOCUMENT_ROOT}/frontend/public/$1 -f
    RewriteRule ^(.+)$ frontend/public/$1 [L]

    # 8. Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 9. Send all remaining requests to Laravel's index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Disable Passenger for Laravel's index.php so PHP handles it
<Files "index.php">
    <IfModule mod_passenger.c>
        PassengerEnabled off
    </IfModule>
</Files>
